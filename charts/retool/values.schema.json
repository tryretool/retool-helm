{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bundled": {
          "type": "boolean"
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host",
            "port",
            "database",
            "user"
          ],
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1
            },
            "database": {
              "type": "string",
              "minLength": 1
            },
            "user": {
              "type": "string",
              "minLength": 1
            },
            "passwordSecretName": {
              "type": "string",
              "minLength": 1
            },
            "passwordSecretKey": {
              "type": "string",
              "minLength": 1
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "ssl_enabled": {
              "type": "boolean"
            },
            "password": {
              "type": "string"
            }
          }
        }
      }
    },
    "temporal": {
      "type": "object",
      "properties": {
        "bundled": {
          "type": "boolean"
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host",
            "port",
            "namespace"
          ],
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1
            },
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "sslCert": {
              "type": "string",
              "minLength": 1
            },
            "sslKey": {
              "type": "string",
              "minLength": 1
            },
            "sslKeySecretName": {
              "type": "string",
              "minLength": 1
            },
            "sslKeySecretKey": {
              "type": "string",
              "minLength": 1
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "sslEnabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "ingress",
            "gateway",
            "external"
          ]
        }
      }
    }
  }
}
